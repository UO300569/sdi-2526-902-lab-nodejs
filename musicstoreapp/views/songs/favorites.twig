{% extends "layout.twig" %}
{% block title %} Canciones Favoritas {% endblock %}

{% block main_container %}
    <h2>Mis Canciones Favoritas</h2>

    <div class="row">
        {% for fav in favorites %}
            <div class="col-xs-6 col-sm-6 col-md-4 col-lg-3">
                <div style="width:200px; margin-bottom: 20px;">
                    <a href="/songs/{{ fav.song_id }}">
                        <img src="/covers/{{ fav.song_id }}.png" alt="portada" style="width:100%"/>
                        <div><strong>{{ fav.title }}</strong></div>
                        <div class="small">Añadida el: {{ fav.date|date("d/m/Y") }}</div>
                        <div class="text-right">{{ fav.price }} €</div>
                    </a>
                    <div class="text-center" style="margin-top: 5px;">
                        <a href="/songs/favorites/delete/{{ fav.song_id }}" class="btn btn-danger btn-xs">
                            Eliminar de favoritos
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}