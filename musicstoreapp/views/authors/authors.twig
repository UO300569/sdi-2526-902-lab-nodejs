{% extends "layout.twig" %}
{% block title %} Listado de autores {% endblock %}

{% block main_container %}
    <h2>Autores</h2>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>Nombre</th>
                <th>Grupo</th>
                <th>Rol</th>
            </tr>
            </thead>
            <tbody>
            {% for author in authors %}
                <tr>
                    <td>{{ author.name }}</td>
                    <td>{{ author.group }}</td>
                    <td>{{ author.rol }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <a href="/authors/add" class="btn btn-success">Añadir nuevo autor</a>
{% endblock %}